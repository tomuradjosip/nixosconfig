# Example GitHub Actions workflow for the nixos-ci-runner-validation harness.
# The harness retains a live copy as .github/workflows/e2e-platform-smoke.yml
# (workflow_dispatch only). Triggers on workflow_dispatch.
name: e2e-platform-smoke
on:
  workflow_dispatch:
jobs:
  combined:
    runs-on: [self-hosted, Linux, X64, nixos-ephemeral-ci]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "24"
      - name: Resource baseline
        run: |
          set -euo pipefail
          echo "== free =="; free -m || true
          echo "== df =="; df -h / /tmp || true
          echo "== nproc =="; nproc || true
          echo "== memory.peak ==";
          cg="$(awk -F: 'NR==1{print $3}' /proc/self/cgroup 2>/dev/null || true)"
          if [[ -n "$cg" && -r "/sys/fs/cgroup${cg}/memory.peak" ]]; then
            cat "/sys/fs/cgroup${cg}/memory.peak"
          else
            echo unavailable
          fi
      - name: Combined Podman + Playwright smoke
        env:
          DEBUG: pw:browser
          # Explicit current stable validated in nixosconfig fixtures (override to pin).
          PLAYWRIGHT_VERSION: "1.62.1"
        run: bash fixtures/ci-runner-e2e/combined-smoke.sh
      - name: Resource after
        if: always()
        run: |
          set -euo pipefail
          echo "== free =="; free -m || true
          echo "== df =="; df -h / /tmp || true
          echo "== playwright cache =="; du -sh "${HOME}/.cache/ms-playwright" 2>/dev/null || true
          echo "== podman system df =="; podman system df 2>/dev/null || true
          cg="$(awk -F: 'NR==1{print $3}' /proc/self/cgroup 2>/dev/null || true)"
          if [[ -n "$cg" && -r "/sys/fs/cgroup${cg}/memory.peak" ]]; then
            echo "== memory.peak =="; cat "/sys/fs/cgroup${cg}/memory.peak"
          fi
